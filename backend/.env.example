# Copy to .env and fill in for production. Never commit the real .env file.

# Postgres in production, e.g. postgresql+psycopg2://user:pass@host:5432/washcare
DATABASE_URL=sqlite:///./washcare.db

# Generate a long random string for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional integrations
SMS_GATEWAY_API_KEY=

# Email notifications on every new booking/enquiry (Gmail example — use an
# "app password", not your normal password: https://myaccount.google.com/apppasswords).
# Leave these blank to skip email notifications entirely.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
